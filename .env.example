# PremiKeys E-Commerce Platform Environment Variables
# Copy this file to .env for local development. NEVER commit real .env files to Git.

# Database Connection (PostgreSQL / Supabase URL with TLS required in production)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Admin & Customer Authentication & Session Secrets (Generate with: openssl rand -hex 32)
SESSION_SECRET="replace_with_64_char_cryptographic_random_hex_secret_in_production"
JWT_SECRET="replace_with_64_char_cryptographic_random_hex_secret_in_production"
ADMIN_SESSION_COOKIE="premikeys_admin_session"

# Initial Super Admin Bootstrap Password (Optional override for first-time seed only)
INITIAL_ADMIN_PASSWORD=""

# Application URLs
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_STORE_NAME="PremiKeys"

# Official Google reCAPTCHA v2 Configuration
# Get your keys at: https://www.google.com/recaptcha/admin/create
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""

# Google OAuth 2.0 (Login with Google)
# Create OAuth 2.0 Web Client at: https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins: http://localhost:3000 (and https://yourdomain.com)
# Authorized redirect URIs: http://localhost:3000/api/auth/google/callback (and https://yourdomain.com/api/auth/google/callback)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Telegram Bot Integration (Server-Side Only — Never expose to client)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Optional Email / Notification Integrations (SMTP / Resend / SendGrid)
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="orders@premikeys.com"

# Optional SMS / OTP Integration (Twilio / Unifonic)
SMS_API_KEY=""
SMS_SENDER_ID=""

# Google Gemini Flash Vision API (Server-Side Payment Proof & Receipt Verification)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
